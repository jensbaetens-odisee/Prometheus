# Kopieer naar .env en pas aan ( .env staat in .gitignore )

# Optioneel: root voor admin/filesystem-tools (allowlist)
# PROMETHEUS_DATA_ROOT=C:\Users\jens.baetens3\Documents\School

# Ollama (default http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# Modellen (moeten lokaal gepulled zijn)
# OLLAMA_CHAT_MODEL=llama3.1:8b
# OLLAMA_ROUTER_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Privacy
# PROMETHEUS_ALLOW_ONLINE_TOOLS=false
